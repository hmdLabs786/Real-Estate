rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'habban.madani786@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validations ---

    function isValidProperty(data) {
      return data.keys().hasAll(['title', 'price', 'type', 'status', 'createdAt']) &&
             data.keys().size() <= 20 &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.type in ['house', 'apartment', 'plot'] &&
             data.status in ['available', 'sold'];
    }

    function isValidLead(data) {
      // Basic core fields required. Others are collected progressively.
      return data.keys().hasAll(['userId', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             (data.budget == null || data.budget is number) &&
             data.status in ['unqualified', 'qualified', 'serious'];
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['propertyId', 'userId', 'date', 'time', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.propertyId is string &&
             data.status in ['pending', 'confirmed', 'cancelled'];
    }

    // --- Rules ---

    match /properties/{propertyId} {
      allow read: if true; // Public listings
      allow create: if isAdmin() && isValidProperty(incoming());
      allow update: if isAdmin() && isValidProperty(incoming());
      allow delete: if isAdmin();
    }

    match /leads/{leadId} {
      allow get: if isOwner(leadId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isEmailVerified() && isValidLead(incoming());
      allow update: if (isOwner(leadId) && isValidLead(incoming())) || isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isEmailVerified() && isValidBooking(incoming()) && exists(/databases/$(database)/documents/properties/$(incoming().propertyId));
      allow update: if (isOwner(existing().userId) && isValidBooking(incoming())) || isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via console
    }
  }
}
